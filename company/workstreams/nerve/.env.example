# Copy to .env and fill in locally. Never commit .env.

# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# BLS Public Data API v2 key (free, optional; raises limits): https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Socrata app token for data.texas.gov and data.austintexas.gov (free, optional; avoids throttling)
# https://data.texas.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Later phases (R2 releases)
CENSUS_API_KEY=
EIA_API_KEY=
