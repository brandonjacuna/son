# Binary CAD and media go through Git LFS. Text-native geometry (.py, .kcl, .ifc, .dxf) stays in plain git so it diffs.
*.skp   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.FCStd filter=lfs diff=lfs merge=lfs -text
*.3dm   filter=lfs diff=lfs merge=lfs -text
*.dwg   filter=lfs diff=lfs merge=lfs -text
*.rfa   filter=lfs diff=lfs merge=lfs -text
*.stl   filter=lfs diff=lfs merge=lfs -text
*.3mf   filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.heic  filter=lfs diff=lfs merge=lfs -text
